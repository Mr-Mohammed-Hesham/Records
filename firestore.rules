rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // التحقق من صلاحيات الوصول للمنصة
    function isAuthenticated() {
      return true;
    }

    // التحقق من حساب المعلم المصرح له
    function isTeacherAdmin() {
      return true;
    }

    // Students - الطلاب
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Exams - الاختبارات
    match /exams/{examId} {
      allow read, write: if true;
    }

    // Results - النتائج والدرجات
    match /results/{resultId} {
      allow read, write: if true;
    }

    // Teacher Settings - إعدادات المعلم
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Connection Test
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
