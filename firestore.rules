rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Students - الطلاب
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Exams - الاختبارات
    match /exams/{examId} {
      allow read, write: if true;
    }

    // Results - النتائج والدرجات
    match /results/{resultId} {
      allow read, write: if true;
    }

    // Teacher Settings - إعدادات المعلم
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Structures - الهياكل
    match /structures/{structureId} {
      allow read, write: if true;
    }

    // Student Structure Progress - سجل حل الطلاب للهياكل
    match /structureProgress/{progressId} {
      allow read, write: if true;
    }

    // Overtime & Financial Entries - سجلات الأوفر تايم والمالية
    match /overtimeEntries/{entryId} {
      allow read, write: if true;
    }

    match /overtimeMonthlyConfigs/{configId} {
      allow read, write: if true;
    }

    // Teacher Workspace Tasks & Notes - لوحة مهام وملاحظات المستر
    match /teacherTasks/{taskId} {
      allow read, write: if true;
    }

    match /teacherNotes/{noteId} {
      allow read, write: if true;
    }

    // Connection Test
    match /test/{testId} {
      allow read, write: if true;
    }

    // Global match to prevent any permission errors on subcollections or queries
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

